{
  "title": "TxWatch",
  "uid": "txwatch",
  "tags": [
    "txwatch"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "contract",
        "type": "query",
        "label": "Contract",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(txwatch_transactions_total, contract)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Seconds since last successful poll",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - txwatch_last_successful_poll_timestamp_seconds{contract=~\"$contract\"}",
          "legendFormat": "{{contract}} ({{network}})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consecutive poll failures",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "txwatch_consecutive_poll_failures{contract=~\"$contract\"}",
          "legendFormat": "{{contract}} ({{network}})"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Transactions / s",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (contract) (rate(txwatch_transactions_total{contract=~\"$contract\"}[$__rate_interval]))",
          "legendFormat": "{{contract}}"
        },
        {
          "refId": "B",
          "expr": "sum by (contract) (rate(txwatch_transactions_skipped_total{contract=~\"$contract\"}[$__rate_interval]))",
          "legendFormat": "{{contract}} skipped"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Alerts and webhook failures / s",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (contract) (rate(txwatch_alerts_total{contract=~\"$contract\"}[$__rate_interval]))",
          "legendFormat": "{{contract}} alerts"
        },
        {
          "refId": "B",
          "expr": "sum by (contract) (rate(txwatch_webhook_failures_total{contract=~\"$contract\"}[$__rate_interval]))",
          "legendFormat": "{{contract}} failures"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Horizon request latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (network, le) (rate(txwatch_horizon_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{network}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (network, le) (rate(txwatch_horizon_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{network}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Webhook delivery latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(txwatch_webhook_delivery_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(txwatch_webhook_delivery_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Build info",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "txwatch_build_info",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}
